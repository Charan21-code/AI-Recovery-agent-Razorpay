# Application
APP_NAME=RevenueRecoveryIntelligenceEngine
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
LOG_LEVEL=INFO

# Database
DATABASE_URL=sqlite+aiosqlite:///./backend/data/recovery_engine.db
SYNC_DATABASE_URL=sqlite:///./backend/data/recovery_engine.db

# Razorpay Integration (Test Mode)
RAZORPAY_MODE=test
RAZORPAY_KEY_ID=rzp_test_example_key
RAZORPAY_KEY_SECRET=example_secret_key
RAZORPAY_WEBHOOK_SECRET=example_webhook_secret

# LLM Reasoning Configuration
LLM_PROVIDER=mock_or_api
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash
LLM_TEMPERATURE=0.2

# Policy Engine Defaults
MAX_PAYMENT_RETRIES=3
MIN_CONFIDENCE_THRESHOLD=0.70
RETRY_WINDOW_HOURS=24
MIN_RETRY_INTERVAL_MINUTES=30
MAX_AUTOMATED_INTERVENTIONS=3
ALLOW_DISCOUNT=false
MAX_DISCOUNT_PERCENT=10.0
HUMAN_ESCALATION_AFTER_ATTEMPTS=3

# Simulation
DEFAULT_SIMULATION_SEED=42
